# =============================================================================
# MEMORA environment variables
# Copy this file to .env and fill in local values.
# Never commit .env. Never put API keys in frontend source.
# Frontend may only read variables prefixed with VITE_ (public config only).
# =============================================================================

# --- Application ---
APP_NAME=MEMORA
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0

# --- Database (SQLite for development; switch to PostgreSQL later) ---
# SQLite example:
DATABASE_URL=sqlite:///./data/memora.db
# PostgreSQL example (later):
# DATABASE_URL=postgresql+psycopg://memora:memora@localhost:5432/memora

# --- Security ---
# Generate a long random string before any production use.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (PUBLIC only — no secrets) ---
# Used by the Vite app. Empty string uses the Vite /api proxy in development.
VITE_API_BASE_URL=http://localhost:8000

# --- LLM (server-side only) ---
# Providers: none | openai | azure | anthropic
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# --- Embeddings (server-side only) ---
# Providers: none | openai
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=text-embedding-3-small

# --- Speech (server-side only) ---
# Providers: none | openai | browser (browser STT/TTS is a frontend fallback)
STT_PROVIDER=none
TTS_PROVIDER=none
STT_MODEL=whisper-1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
